###############################################
# ReelForge backend — environment configuration
# Copy this file to `.env` and fill in what you use.
# NEVER commit the real .env file.
###############################################

# Port for the API server
PORT=8787

# Optional shared secret the extension must send in the "x-ugc-token" header.
# Set the SAME value in the extension: Settings → Connection → Access token.
# Leave empty to disable token checking (fine for localhost development).
EXTENSION_TOKEN=

# Allowed extra origin (e.g. your deployed extension web app). Chrome extension
# origins (chrome-extension://...) and localhost are always allowed.
EXTRA_ORIGIN=

# ---------------- Provider API keys ----------------
# Fill ONLY the providers you use. The extension picks providers in Settings.

# LLM (script understanding, storyboard, hooks) + vision + TTS + images
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Any OpenAI-compatible endpoint (Groq, OpenRouter, LM Studio, ...)
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=

# Image generation
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=

# Voice
ELEVENLABS_API_KEY=
