# Keep these values on the server only. Never paste them into the extension settings.
PORT=8787
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional JSON map for multiple selectable voices, e.g. {"Asha · warm Indian":"voice-id-1","Arjun · clear Indian":"voice-id-2"}
ELEVENLABS_VOICES_JSON={}
ELEVENLABS_MODEL=eleven_multilingual_v2
# AI scene video. Configure a legally available Replicate image-to-video or audio-lip-sync model.
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=
REPLICATE_VIDEO_VERSION=
VIDEO_PROVIDER_BASE_URL=https://api.replicate.com
VIDEO_PROMPT_FIELD=prompt
VIDEO_IMAGE_FIELD=image
# Optional model-specific array field for creator + product references, e.g. reference_images
VIDEO_REFERENCE_IMAGES_FIELD=
VIDEO_AUDIO_FIELD=audio
VIDEO_NEGATIVE_PROMPT_FIELD=negative_prompt
