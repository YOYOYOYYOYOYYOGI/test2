# Copy to .env (loaded manually; the server has zero npm dependencies)
# or export these variables in your host's dashboard (Render/Railway/Fly/Cloud Run).

# Port the proxy listens on (host platforms set PORT automatically)
PORT=8787

# Shared secret the extension sends in the X-ReelForge-Key header.
# Use a long random string, e.g.  openssl rand -hex 32
PROXY_KEY=change-me-to-a-long-random-secret

# ---- Language model ----
# LLM_PROVIDER = gemini | openai (any OpenAI-compatible chat API) | fal
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: override the native Gemini REST endpoint (e.g. for a Google-compatible proxy)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-2.5-flash
# For LLM_PROVIDER=openai use:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# For LLM_PROVIDER=fal use FAL_KEY and:
# LLM_MODEL=openai/gpt-4o-mini

# ---- Image generation ----
# IMAGE_PROVIDER = fal or openai
IMAGE_PROVIDER=fal
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/kontext/max
# For IMAGE_PROVIDER=openai:
IMAGE_MODEL=gpt-image-1

# ---- Video generation ----
# VIDEO_PROVIDER = fal or openai
VIDEO_PROVIDER=fal
FAL_VIDEO_MODEL=fal-ai/kling-video/v2/master/image-to-video
VIDEO_MODEL=sora-2
