{
  "manifest_version": 3,
  "name": "Order Label Manager \u2014 WhatsApp Orders to Sheets & Labels",
  "short_name": "Order Label Mgr",
  "version": "1.0.9",
  "description": "Turn WhatsApp orders into spreadsheet rows and printable shipping labels. Works with Google Sheets.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Order Label Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "identity",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "version_name": "1.0.9",
  "key": "",
  "oauth2": {
    "client_id": "PASTE_YOUR_GOOGLE_CLIENT_ID_HERE",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.readonly",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  }
}
