{
  "name": "order-label-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chrome extension: WhatsApp orders → Google Sheets → printable shipping labels",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/zip.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/units.test.ts && tsx tests/extension.test.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "happy-dom": "^20.14.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
